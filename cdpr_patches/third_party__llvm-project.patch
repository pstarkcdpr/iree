+//===----------------------------------------------------------------------===//
+// Stable hashing
+//===----------------------------------------------------------------------===//
+
+namespace {
+/// Accumulates values into a hash that is stable across runs and platforms.
+/// Unlike `llvm::hash_combine`, the result does not depend on a per-process
+/// seed, so it can be used in output that is compared between runs.
+class StableHasher {
+public:
+  StableHasher &add(uint64_t value) {
+    uint8_t bytes[sizeof(uint64_t)];
+    llvm::support::endian::write64le(bytes, value);
+    data.append(std::begin(bytes), std::end(bytes));
+    return *this;
+  }
+  StableHasher &add(StringRef str) { return add(llvm::xxh3_64bits(str)); }
+
+  uint64_t get() const { return llvm::xxh3_64bits(data); }
+
+private:
+  SmallVector<uint8_t, 64> data;
+};
+} // namespace
+
+/// Return a stable hash of the element data of the given ElementsAttr.
+static uint64_t hashElementsAttrContents(ElementsAttr attr) {
+  if (auto sparseAttr = dyn_cast<SparseElementsAttr>(attr)) {
+    return StableHasher()
+        .add(hashElementsAttrContents(sparseAttr.getIndices()))
+        .add(hashElementsAttrContents(sparseAttr.getValues()))
+        .get();
+  }
+  if (auto stringAttr = dyn_cast<DenseStringElementsAttr>(attr)) {
+    StableHasher hasher;
+    for (StringRef str : stringAttr.getRawStringData())
+      hasher.add(str.size()).add(str);
+    return hasher.get();
+  }
+  if (auto denseAttr = dyn_cast<DenseElementsAttr>(attr)) {
+    ArrayRef<char> rawData = denseAttr.getRawData();
+    return llvm::xxh3_64bits(ArrayRef(
+        reinterpret_cast<const uint8_t *>(rawData.data()), rawData.size()));
+  }
+  llvm_unreachable("unexpected kind of elided ElementsAttr");
+}
+
+namespace {
+/// Computes hashes of SSA values from the contents of the operations that
+/// define them, rather than from their position in the IR. These are used to
+/// derive SSA names that stay the same when unrelated operations are added or
+/// removed.
+///
+/// The hash of an operation at depth N combines the contents of the operation
+/// itself (name, attributes, types and nested regions) with the hashes at
+/// depth N-1 of the values it uses. Bounding the depth prevents a change to one
+/// operation from renaming every value downstream of it, so callers should use
+/// the smallest depth that still produces a unique name.
+class StableValueHasher {
+public:
+  explicit StableValueHasher(MLIRContext *context);
+
+  /// Return the hash of `value`, covering up to `depth` levels of operations
+  /// upstream of it.
+  uint64_t getValueHash(Value value, unsigned depth);
+
+private:
+  /// Return the hash of `op`, covering up to `depth` levels upstream of it.
+  uint64_t getOpHash(Operation *op, unsigned depth);
+
+  /// Return the hash of the contents of `op`, independent of its operands.
+  uint64_t getLocalOpHash(Operation *op);
+
+  /// Return a hash of the structure of `region`. Values defined inside the
+  /// region are identified by their position within it, values defined outside
+  /// of it only by their type.
+  uint64_t getRegionHash(Region &region);
+
+  /// Return a hash of the position and type of a block argument.
+  uint64_t getBlockArgHash(BlockArgument arg);
+
+  /// Attributes and types are hashed through their textual form, which unlike
+  /// their storage pointer does not change between runs.
+  uint64_t getAttrHash(Attribute attr);
+  uint64_t getTypeHash(Type type);
+
+  /// The state used to print attributes and types for hashing.
+  AsmState printState;
+
+  DenseMap<std::pair<Operation *, unsigned>, uint64_t> opHashes;
+  DenseMap<Operation *, uint64_t> localOpHashes;
+  DenseMap<Attribute, uint64_t> attrHashes;
+  DenseMap<Type, uint64_t> typeHashes;
+};
+} // namespace
+
+StableValueHasher::StableValueHasher(MLIRContext *context)
+    : printState(context, OpPrintingFlags()
+                              .elideLargeElementsAttrs()
+                              .elideLargeElementsAttrsWithHash()
+                              .enableDebugInfo(false)) {}
+
+uint64_t StableValueHasher::getValueHash(Value value, unsigned depth) {
+  if (auto result = dyn_cast<OpResult>(value)) {
+    return StableHasher()
+        .add(getOpHash(result.getOwner(), depth))
+        .add(result.getResultNumber())
+        .get();
+  }
+  return getBlockArgHash(cast<BlockArgument>(value));
+}
+
+uint64_t StableValueHasher::getOpHash(Operation *op, unsigned depth) {
+  if (depth == 0)
+    return getLocalOpHash(op);
+  auto key = std::make_pair(op, depth);
+  if (auto it = opHashes.find(key); it != opHashes.end())
+    return it->second;
+
+  StableHasher hasher;
+  hasher.add(getLocalOpHash(op));
+  for (Value operand : op->getOperands())
+    hasher.add(getValueHash(operand, depth - 1));
+  uint64_t hash = hasher.get();
+  opHashes[key] = hash;
+  return hash;
+}
+
+uint64_t StableValueHasher::getLocalOpHash(Operation *op) {
+  if (auto it = localOpHashes.find(op); it != localOpHashes.end())
+    return it->second;
+
+  StableHasher hasher;
+  hasher.add(op->getName().getStringRef());
+  hasher.add(getAttrHash(op->getAttrDictionary()));
+  hasher.add(op->getNumOperands());
+  for (Type type : op->getOperandTypes())
+    hasher.add(getTypeHash(type));
+  hasher.add(op->getNumResults());
+  for (Type type : op->getResultTypes())
+    hasher.add(getTypeHash(type));
+  hasher.add(op->getNumSuccessors());
+  hasher.add(op->getNumRegions());
+  for (Region &region : op->getRegions())
+    hasher.add(getRegionHash(region));
+  uint64_t hash = hasher.get();
+  localOpHashes[op] = hash;
+  return hash;
+}
+
+uint64_t StableValueHasher::getRegionHash(Region &region) {
+  // Number the values defined in the region in order of definition, so that
+  // uses of them can be identified without relying on names.
+  DenseMap<Value, uint64_t> localValueIds;
+  StableHasher hasher;
+  for (Block &block : region) {
+    hasher.add(block.getNumArguments());
+    for (BlockArgument arg : block.getArguments()) {
+      hasher.add(getTypeHash(arg.getType()));
+      localValueIds.try_emplace(arg, localValueIds.size());
+    }
+    for (Operation &op : block) {
+      hasher.add(getLocalOpHash(&op));
+      for (Value operand : op.getOperands()) {
+        auto it = localValueIds.find(operand);
+        hasher.add(it == localValueIds.end() ? ~uint64_t(0) : it->second);
+      }
+      for (Value result : op.getResults())
+        localValueIds.try_emplace(result, localValueIds.size());
+    }
+  }
+  return hasher.get();
+}
+
+uint64_t StableValueHasher::getBlockArgHash(BlockArgument arg) {
+  StableHasher hasher;
+  Block *block = arg.getOwner();
+  if (Region *region = block->getParent()) {
+    if (Operation *parentOp = region->getParentOp()) {
+      hasher.add(parentOp->getName().getStringRef());
+      hasher.add(region->getRegionNumber());
+    }
+    hasher.add(std::distance(region->begin(), block->getIterator()));
+  }
+  hasher.add(arg.getArgNumber());
+  hasher.add(getTypeHash(arg.getType()));
+  return hasher.get();
+}
+
+uint64_t StableValueHasher::getAttrHash(Attribute attr) {
+  if (auto it = attrHashes.find(attr); it != attrHashes.end())
+    return it->second;
+  std::string str;
+  llvm::raw_string_ostream os(str);
+  attr.print(os, printState);
+  uint64_t hash = llvm::xxh3_64bits(str);
+  attrHashes[attr] = hash;
+  return hash;
+}
+
+uint64_t StableValueHasher::getTypeHash(Type type) {
+  if (auto it = typeHashes.find(type); it != typeHashes.end())
+    return it->second;
+  std::string str;
+  llvm::raw_string_ostream os(str);
