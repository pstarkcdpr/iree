+def StabilizePrivateFuncNamesPass : Pass<"stabilize-private-func-names"> {
+  let summary = "Rename private functions based on their contents";
+  let description = [{
+    This pass renames the private functions of every symbol table to names
+    derived from their contents, so that the names do not depend on the order
+    in which the functions were created. This makes textual diffs of IR more
+    meaningful when the producer uniques function names by adding a counter.
+
+    The new name consists of the original name with trailing numeric suffixes
+    (`_N`) removed, followed by a hash of the function. For example,
+    `@normalize_383` becomes `@normalize_1a2b3c4d`. References to other private
+    functions are hashed by their name without suffixes, so a change to a
+    function does not rename its callers. Functions that are identical get an
+    additional numeric suffix, in order.
+
+    Only private functions are renamed, as other functions may be referenced
+    from outside of the IR.
+  }];
+}
